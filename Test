-- drawing pool
local pool={}
local function D(t,p) local d=Drawing.new(t) for k,v in pairs(p) do pcall(function()d[k]=v end) end return d end
local function gc(pl)
    if pool[pl] then return pool[pl] end
    local t={box={}}
    for i=1,4 do t.box[i]=D("Line",{Visible=false,Color=CFG.BCol,Thickness=1}) end
    t.tr=D("Line",{Visible=false,Color=CFG.TCol,Thickness=1})
    t.nm=D("Text",{Visible=false,Size=13,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0)})
    t.hb=D("Line",{Visible=false,Color=Color3.new(0,0,0),Thickness=4})
    t.hf=D("Line",{Visible=false,Thickness=3})
    t.ds=D("Text",{Visible=false,Size=11,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0)})
    pool[pl]=t return t
end
local function hide(t)
    if not t then return end
    for _,l in ipairs(t.box) do pcall(function()l.Visible=false end) end
    for _,k in ipairs({"tr","nm","hb","hf","ds"}) do pcall(function()t[k].Visible=false end) end
end
Players.PlayerRemoving:Connect(function(p)
    if not pool[p] then return end
    hide(pool[p])
    for _,l in ipairs(pool[p].box) do pcall(function()l:Remove()end) end
    for _,k in ipairs({"tr","nm","hb","hf","ds"}) do pcall(function()pool[p][k]:Remove()end) end
    pool[p]=nil
end)

local FL={} for i=1,4 do FL[i]=D("Line",{Visible=false,Color=Color3.new(1,1,1),Thickness=1}) end
local function fovDraw()
    local c,r=Cam.ViewportSize/2,CFG.FovR
    local pts={{c+Vector2.new(-r,-r),c+Vector2.new(r,-r)},{c+Vector2.new(-r,r),c+Vector2.new(r,r)},
               {c+Vector2.new(-r,-r),c+Vector2.new(-r,r)},{c+Vector2.new(r,-r),c+Vector2.new(r,r)}}
    for i,p in ipairs(pts) do pcall(function()FL[i].From=p[1] FL[i].To=p[2] FL[i].Visible=CFG.Fov end) end
end

local function sc() return Cam.ViewportSize/2 end
local function ts(p) local s,v,z=Cam:WorldToViewportPoint(p) return Vector2.new(s.X,s.Y),v,z end
local function alive(p) local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid") return h and h.Health>0 end
local function bbox(p)
    local c=p.Character if not c then return end
    local r=c:FindFirstChild("HumanoidRootPart") if not r then return end
    local hum=c:FindFirstChildOfClass("Humanoid")
    local ht=(hum and hum.HipHeight*2+0.5) or 5
    local sT,vT,zT=ts(r.Position+Vector3.new(0,ht*.6,0))
    local sB,vB,zB=ts(r.Position-Vector3.new(0,ht*.4,0))
    if(not vT and not vB)or(zT<=0 and zB<=0)then return end
    local h=math.abs(sT.Y-sB.Y) local w=h*.5 local cx=(sT.X+sB.X)/2
    return{tl=Vector2.new(cx-w/2,sT.Y),tr=Vector2.new(cx+w/2,sT.Y),
           bl=Vector2.new(cx-w/2,sB.Y),br=Vector2.new(cx+w/2,sB.Y),
           tc=Vector2.new(cx,sT.Y),bc=Vector2.new(cx,sB.Y),lx=cx-w/2}
end
local function bestTarget()
    local best,bh,bd=nil,nil,CFG.FovR*2
    for _,p in ipairs(Players:GetPlayers()) do
        if p==lp or(CFG.Team and p.Team==lp.Team)or not alive(p) then continue end
        local c=p.Character if not c then continue end
        local h=c:FindFirstChild(CFG.Part) if not h then continue end
        local sp,v,z=ts(h.Position) if not v or z<=0 then continue end
        local d=(sp-sc()).Magnitude if d<bd then bd=d best=p bh=h end
    end
    return best,bh
end
local function doAim(h)
    local o=Cam.CFrame local d=(h.Position-o.Position).Unit
    Cam.CFrame=CFrame.new(o.Position,o.Position+d)
    task.defer(function()Cam.CFrame=o end)
end
local function doSmooth(h)
    Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position,h.Position),1-CFG.Smooth)
end
local function espDraw(t,bb,p)
    if CFG.Box then
        local ls={{bb.tl,bb.tr},{bb.bl,bb.br},{bb.tl,bb.bl},{bb.tr,bb.br}}
        for i,l in ipairs(ls) do pcall(function()t.box[i].From=l[1] t.box[i].To=l[2] t.box[i].Color=CFG.BCol t.box[i].Visible=true end) end
    else for _,l in ipairs(t.box) do pcall(function()l.Visible=false end) end end
    if CFG.Tracer then
        local o=Vector2.new(sc().X,Cam.ViewportSize.Y)
        pcall(function()t.tr.From=o t.tr.To=bb.bc t.tr.Color=CFG.TCol t.tr.Visible=true end)
    else pcall(function()t.tr.Visible=false end) end
    if CFG.Name then pcall(function()t.nm.Text=p.DisplayName t.nm.Position=Vector2.new(bb.tc.X,bb.tc.Y-16) t.nm.Color=Color3.new(1,1,1) t.nm.Visible=true end)
    else pcall(function()t.nm.Visible=false end) end
    if CFG.HP then
        local hum=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        local ratio=hum and math.clamp(hum.Health/hum.MaxHealth,0,1) or 0
        local bot=bb.bl.Y local top=bb.tl.Y local fy=bot-(bot-top)*ratio
        pcall(function()t.hb.From=Vector2.new(bb.lx-6,top) t.hb.To=Vector2.new(bb.lx-6,bot) t.hb.Visible=true end)
        pcall(function()t.hf.From=Vector2.new(bb.lx-6,fy) t.hf.To=Vector2.new(bb.lx-6,bot) t.hf.Color=Color3.fromRGB(255-ratio*255,ratio*255,0) t.hf.Visible=true end)
    else pcall(function()t.hb.Visible=false t.hf.Visible=false end) end
    if CFG.Dist then
        local root=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if root then
            local d=math.floor((root.Position-Cam.CFrame.Position).Magnitude)
            pcall(function()t.ds.Text=d.."m" t.ds.Position=Vector2.new(bb.bc.X,bb.bc.Y+2) t.ds.Color=Color3.fromRGB(200,200,200) t.ds.Visible=true end)
        end
    else pcall(function()t.ds.Visible=false end) end
end

